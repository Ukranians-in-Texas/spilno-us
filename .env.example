# Client-side
VITE_CONTACT_EMAIL=example@example.com
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=your_upload_preset
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_publishable_key_here

# Server-side
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key_here
CLOUDINARY_API_SECRET=your_cloudinary_api_secret_here
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_key_here

# Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id
TELEGRAM_WEBHOOK_SECRET=your_random_32plus_char_secret

# Cron / monitoring
# CRON_SECRET: generate with `openssl rand -hex 32`. Vercel auto-sends it as
# `Authorization: Bearer <value>` on cron invocations (var name must be exactly CRON_SECRET).
CRON_SECRET=your_random_32plus_char_secret
# HEALTHCHECK_URL: healthchecks.io ping URL; keep-alive pings it on success (dead-man's-switch).
HEALTHCHECK_URL=https://hc-ping.com/your-check-uuid

# Backups
# GITHUB_TOKEN: fine-grained PAT scoped to this repo with "Contents: Read and write".
# cleanup-images.js uses it to commit a weekly services-table JSON snapshot to the
# data-backups branch. Without it, backups fail (and alert on Telegram) but nothing else breaks.
GITHUB_TOKEN=github_pat_your_token_here
